{
  "name": "warriors-admin-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "docker compose up -d",
    "dev": "next dev",
    "dev:prod": "node scripts/with-env.mjs .env.production.local next dev",
    "build": "next build",
    "start": "next start",
    "build:local": "node scripts/with-env.mjs .env.local next build",
    "start:local": "node scripts/with-env.mjs .env.local next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx seed/seed-cli.ts",
    "db:reset": "tsx seed/reset-cli.ts",
    "publish:preview": "tsx lib/publish/cli.ts",
    "publish:run": "tsx lib/publish/run-cli.ts",
    "publish:run:prod": "node scripts/with-env.mjs .env.production.local tsx lib/publish/run-cli.ts",
    "backup:run": "tsx lib/backup/run-cli.ts",
    "backup:run:prod": "node scripts/with-env.mjs .env.production.local tsx lib/backup/run-cli.ts",
    "backup:restore": "tsx lib/backup/restore-cli.ts",
    "backup:restore:prod": "node scripts/with-env.mjs .env.production.local tsx lib/backup/restore-cli.ts",
    "migrate:additive:preview": "tsx lib/migration/additive/run-cli.ts --dry-run",
    "migrate:additive:run": "tsx lib/migration/additive/run-cli.ts",
    "migrate:reconcile:preview": "tsx lib/migration/reconcile/run-cli.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1111.0",
    "@aws-sdk/client-s3": "^3.1079.0",
    "bson": "^7.3.2",
    "mongodb": "^7.4.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
